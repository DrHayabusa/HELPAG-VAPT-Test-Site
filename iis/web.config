<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="HELPAG lab reverse proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:5005/{R:1}" appendQueryString="true" />
          <serverVariables>
            <!-- Every Splunk detection groups by source_ip, which the app reads
                 from the first X-Forwarded-For entry. Without this the whole
                 detection pack sees 127.0.0.1 for every player. -->
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <add name="X-HELPAG-Lab" value="Intentionally vulnerable training target" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering allowDoubleEscaping="true">
        <!-- Path traversal and encoded payloads must reach the application:
             request filtering would otherwise reject them with a 404 before the
             backend ever sees them, and several challenges would be unsolvable. -->
        <fileExtensions allowUnlisted="true" />
        <hiddenSegments>
          <clear />
        </hiddenSegments>
        <verbs allowUnlisted="true" />
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
