# Copy to .env before `docker compose up`. Lab values only.
LAB_BIND=127.0.0.1

# Deliberately weak - finding weak-session-secret expects a tester to recover it.
LAB_SESSION_SECRET=meridian-default-signing-key
LAB_JWT_KEY=mfs-partner-hs256

# Gate for the operator console at /range/console. Change it for a live exercise
# so testers cannot read the finding list.
RANGE_CONSOLE_TOKEN=range-operator

SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
SPLUNK_INDEX=vapt_lab
SPLUNK_SOURCETYPE=helpag:owasp:json
SPLUNK_VERIFY_TLS=false
