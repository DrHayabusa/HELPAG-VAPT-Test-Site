# Copy to .env before `docker compose up`. Lab values only.
LAB_BIND=127.0.0.1
# Deliberately weak - challenge auth-weak-secret expects players to recover it.
LAB_SESSION_SECRET=deliberately-weak-lab-secret
LAB_JWT_KEY=labkey
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
SPLUNK_INDEX=vapt_lab
SPLUNK_SOURCETYPE=helpag:owasp:json
SPLUNK_VERIFY_TLS=false
